---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Biblical Hebrew Tools">

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <div class="text-center pt-16 pb-12">

    <!-- Hebrew ornament -->
    <p
      class="text-5xl mb-4 select-none opacity-20"
      style="font-family: var(--font-hebrew); color: var(--color-primary);"
      aria-hidden="true"
    >
      אָ בָּ גָּ
    </p>

    <h1
      class="text-5xl font-extrabold mb-4 leading-tight"
      style="color: var(--color-primary);"
    >
      hebrew<span style="color: var(--color-accent);">.tools</span>
    </h1>

    <p class="text-lg text-text-muted max-w-xl mx-auto leading-relaxed">
      Free, simple utilities for Biblical Hebrew students.
    </p>
  </div>

  <!-- ── Tools grid ────────────────────────────────────────────────────── -->
  <div class="max-w-2xl mx-auto pb-20 space-y-4">

    <!-- Keyboard — live -->
    <a
      href="/keyboard"
      class="group block bg-bg-card rounded-2xl shadow-sm border border-white overflow-hidden hover:shadow-md transition-shadow"
    >
      <div class="h-1.5 w-full" style="background: var(--color-primary);" />
      <div class="p-6 flex items-center gap-5">
        <div
          class="w-14 h-14 rounded-xl flex items-center justify-center text-2xl shrink-0"
          style="background: #DCFCE7; color: var(--color-primary); font-family: var(--font-hebrew);"
          aria-hidden="true"
        >
          אָ
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <h2 class="text-lg font-bold" style="color: var(--color-primary);">Hebrew Keyboard</h2>
            <span
              class="text-xs font-semibold px-2 py-0.5 rounded-full"
              style="background: #DCFCE7; color: #15803D;"
            >
              Live
            </span>
          </div>
          <p class="text-sm text-text-muted leading-snug">
            Type Biblical Hebrew with phonetic key mappings — nikud, dagesh, and final forms included.
          </p>
        </div>
        <svg class="w-5 h-5 text-text-muted shrink-0 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <!-- Coming soon tools -->
    {[
      { label: 'Vocabulary Flashcards', description: 'SRS-based flashcards for Biblical Hebrew vocabulary by frequency.' },
      { label: 'Daily Verse', description: 'A new Hebrew Bible verse every day with glosses and morphology.' },
      { label: 'Hebrew Bible Reader', description: 'Read the WLC text with per-word parsing and glosses.' },
      { label: 'Grammar Reference', description: 'Paradigm tables for nouns, verbs, and the seven binyanim.' },
    ].map(tool => (
      <div class="bg-bg-card rounded-2xl border border-white overflow-hidden opacity-60">
        <div class="h-1.5 w-full" style="background: #D1D5DB;" />
        <div class="p-6 flex items-center gap-5">
          <div
            class="w-14 h-14 rounded-xl flex items-center justify-center text-2xl shrink-0 bg-gray-100 text-gray-400"
            aria-hidden="true"
          >
            ✦
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <h2 class="text-lg font-bold text-gray-500">{tool.label}</h2>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-400">
                Coming soon
              </span>
            </div>
            <p class="text-sm text-text-muted leading-snug">{tool.description}</p>
          </div>
        </div>
      </div>
    ))}

    <!-- greek.tools link -->
    <div class="text-center pt-4">
      <p class="text-sm text-text-muted">
        Learning Biblical Greek? Check out
        <a
          href="https://greek.tools"
          class="font-semibold underline underline-offset-2 transition-opacity hover:opacity-70"
          style="color: var(--color-primary);"
        >
          greek.tools
        </a>
      </p>
    </div>
  </div>

</Layout>
